# AliExpress Affiliate API Credentials
# Get your keys from: https://portals.aliexpress.com/

ALIEXPRESS_APP_KEY=your_app_key_here
ALIEXPRESS_APP_SECRET=your_app_secret_here
ALIEXPRESS_AFFILIATE_TRACKING=your_tracking_id_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace the values above with YOUR credentials from AliExpress
# 3. Restart the server
